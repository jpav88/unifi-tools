#!/bin/bash
# Local device config — NOT tracked in git
# Copy this to local/devices.sh and fill in your device MACs
# Source this file in scripts/skills that need device-specific MACs or AP mappings

# iPad MACs (Fixed private address per SSID)
IPAD_PRIMARY="xx:xx:xx:xx:xx:xx"
IPAD_SECONDARY="xx:xx:xx:xx:xx:xx"

# Switch ports expected to link below 1G — suppressed from the snapshot warning
# Format: "<switch name> P<port_idx>" (e.g. a 100M-only device NIC)
EXPECTED_SLOW_PORTS=(
    # "My Switch P8"
)

# AP MAC → friendly name mapping (for skill context)
# Format: MAC|Name|Location
AP_MAP=(
    "xx:xx:xx:xx:xx:xx|AP-Name-1|Location"
    "xx:xx:xx:xx:xx:xx|AP-Name-2|Location"
)

# Format AP_MAP for display
ap_list() {
    for entry in "${AP_MAP[@]}"; do
        IFS='|' read -r mac name loc <<< "$entry"
        echo "- ${name} (\`${mac}\`): ${loc}"
    done
}

# --- Audit targets (scripts/unifi_client_audit.sh) ---
# Real MACs live ONLY here — never in a tracked script (every tracked file is
# copied to the public mirror).
AUDIT_PRIMARY_MAC="xx:xx:xx:xx:xx:xx";   AUDIT_PRIMARY_NAME="Primary Phone"
AUDIT_SECONDARY_MAC="xx:xx:xx:xx:xx:xx"; AUDIT_SECONDARY_NAME="Primary Laptop"
AUDIT_REF1_MAC="xx:xx:xx:xx:xx:xx";      AUDIT_REF1_NAME="Reference Tablet"
AUDIT_REF2_MAC="xx:xx:xx:xx:xx:xx";      AUDIT_REF2_NAME="Reference Phone"

# AP MAC | short name | room — drives the per-AP distribution table
AUDIT_AP_MAP=(
    "xx:xx:xx:xx:xx:xx|Gateway-AP|Home office"
    "xx:xx:xx:xx:xx:xx|Ceiling-AP|Living room"
)
